DJANGO_SECRET_KEY=replace-with-a-local-only-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Gmail SMTP settings for portfolio contact form
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=

# Leave DATABASE_URL empty to use local SQLite. For PostgreSQL, use:
# DATABASE_URL=
DATABASE_URL=
